# Copy to `secrets-payslip-26-6.tfvars` (gitignored) and fill in the real values.
#
# IMPORTANT: Do NOT commit `secrets-payslip-26-6.tfvars`.

keycloak_url = "https://keycloak-demo.solutions.adorsys.com"
realm        = "oid4vc-payslip"

# Kubernetes secret `keycloak-secret` contains:
# - KC_BOOTSTRAP_ADMIN_PASSWORD
admin_password = "<KC_BOOTSTRAP_ADMIN_PASSWORD>"

# Demo users created inside Keycloak.
initial_password                = "<FRANCIS_INITIAL_PASSWORD>"
max_mustermann_initial_password = "<MAX_MUSTERMANN_INITIAL_PASSWORD>"

# Confidential client secret for Keycloak client `openid4vc-rest-api`.
# Create/fetch it once and keep it stable across applies.
openid4vc_rest_api_client_secret = "<OPENID4VC_REST_API_CLIENT_SECRET>"

# Optional: enable RSA key import/usage for OID4VC.
# - false: disable RSA providers (recommended default)
# - true: keep/import RSA keys
enable_rsa_keys = false

# OID4VC signing key configuration.
oid4vc_keystore_path     = "/path/to/oid4vc-ecdsa-only.p12"
oid4vc_keystore_password = "<OID4VC_KEYSTORE_PASSWORD>"
oid4vc_keystore_type     = "PKCS12"
oid4vc_ecdsa_key_alias   = "ecdsa_team_key"

# Optional: issuer root display metadata (realm attribute: oid4vci.display).
# Must be a JSON array string.
oid4vci_display = "[{\"name\":\"DATEV Gehaltsnachweis\",\"locale\":\"de-DE\",\"logo\":{\"uri\":\"https://wallet-app-metadata.s3.eu-north-1.amazonaws.com/datev_logo.png\",\"alt_text\":\"DATEV\"}}]"

# For the payslip realm, attach the payslip credential scope to both clients.
optional_client_scope_client_ids = [
  "oid4vc-demo-public",
  "openid4vc-rest-api"
]

# Keep exactly one scope/VCT here for the OID4VP verifier plugin.
enabled_scope_names = [
  "PayslipCredential"
]

# SdJwtAuthenticator settings
sdjwt_client_id_scheme  = "x509_hash"
sdjwt_query_language    = "dcql_query"
sdjwt_response_mode     = "direct_post.jwt"
sdjwt_custom_url_scheme = "openid4vp://"

# Paste full values only in local gitignored secrets-payslip-26-6.tfvars.
sdjwt_access_certificate       = "<ACCESS_CERTIFICATE_BASE64_DER>"
sdjwt_registration_certificate = "<REGISTRATION_CERTIFICATE_JWT>"
