# Copy to `secrets-v-playground.tfvars` (gitignored) and fill in the real values.
#
# IMPORTANT: Do NOT commit `secrets-v-playground.tfvars`.

keycloak_url = "https://keycloak-demo.solutions.adorsys.com"
realm        = "oid4vc-v-playground"

# Kubernetes secret `keycloak-secret` contains the Keycloak bootstrap admin password.
admin_password = "<KC_BOOTSTRAP_ADMIN_PASSWORD>"

# Demo users created inside Keycloak.
initial_password                = "<FRANCIS_INITIAL_PASSWORD>"
max_mustermann_initial_password = "<MAX_MUSTERMANN_INITIAL_PASSWORD>"

# Confidential client secret for Keycloak client `openid4vc-rest-api`.
# Create/fetch it once and keep it stable across applies.
openid4vc_rest_api_client_secret = "<OPENID4VC_REST_API_CLIENT_SECRET>"

# Optional: enable RSA key import/usage for OID4VC.
# - false: disable RSA providers (recommended default)
# - true: keep/import RSA keys
enable_rsa_keys = false

# OID4VC signing key configuration.
oid4vc_keystore_path     = "/path/to/oid4vc-ecdsa-only.p12"
oid4vc_keystore_password = "<OID4VC_KEYSTORE_PASSWORD>"
oid4vc_keystore_type     = "PKCS12"
oid4vc_ecdsa_key_alias   = "ecdsa_team_key"

# Preserve the verifier-playground realm scope selection.
optional_client_scope_client_ids = [
  "oid4vc-demo-public",
  "openid4vc-rest-api"
]

enabled_scope_names = [
  "IdentityCredential",
  "BankEmployeeCredential",
  "CityRegistryCredential"
]

# OID4VP authenticator settings for plugin 1.3.4
oid4vp_authentication_profiles                 = ""
oid4vp_client_identifier_prefix                = "x509_hash"
oid4vp_response_mode                           = "direct_post.jwt"
oid4vp_request_uri_method                      = "get"
oid4vp_custom_url_scheme                       = "openid4vp://"
oid4vp_transaction_data                        = ""
oid4vp_verifier_info                           = ""
oid4vp_require_cryptographic_holder_binding    = "true"
oid4vp_holder_binding_proof_max_age            = "60"
oid4vp_require_nbf_claim                       = "false"
oid4vp_require_exp_claim                       = "false"
oid4vp_verify_issuer_claim                     = "true"
oid4vp_fallback_to_iso_spec_session_transcript = "false"
oid4vp_enforce_revocation_status               = "false"
# Paste full values only in the local gitignored tfvars file.
oid4vp_access_certificate       = "<ACCESS_CERTIFICATE_BASE64_DER>"
oid4vp_registration_certificate = "<REGISTRATION_CERTIFICATE_JWT>"

# oid4vc-demo-public URLs preserved from the verifier-playground realm.
oid4vc_demo_public_valid_redirect_uris = [
  "https://adorsys-gis.github.io/keycloak-oid4vc-mock-fe/*",
  "http://localhost:4200/*"
]

oid4vc_demo_public_web_origins = [
  "https://adorsys-gis.github.io",
  "http://localhost:4200"
]

oid4vc_demo_public_post_logout_redirect_uris = "http://localhost:4200##http://localhost:4200/*##https://adorsys-gis.github.io/keycloak-oid4vc-mock-fe/*"
