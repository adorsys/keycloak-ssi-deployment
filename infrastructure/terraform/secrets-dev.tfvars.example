# Copy to `secrets-dev.tfvars` (gitignored) and fill in the real values.
#
# IMPORTANT: Do NOT commit `secrets-dev.tfvars`.

keycloak_url = "https://keycloak-demo.eudi-adorsys.com"

# Kubernetes secret `keycloak-secret` (in namespace `datev-wallet`) contains:
# - KC_BOOTSTRAP_ADMIN_PASSWORD
admin_password = "<KC_BOOTSTRAP_ADMIN_PASSWORD>"

# Used to create the demo/test user `francis` inside Keycloak.
initial_password = "francis"

# Confidential client secret for Keycloak client `openid4vc-rest-api`.
# Create/fetch it once and keep it stable across applies.
openid4vc_rest_api_client_secret = "<OPENID4VC_REST_API_CLIENT_SECRET>"

# Optional: enable RSA key import/usage for OID4VC.
# - false: disable RSA providers (recommended default)
# - true: keep/import RSA keys
enable_rsa_keys = false

# OID4VP Authenticator (keycloak-oid4vp-plugin) settings
sdjwt_client_identifier_prefix     = "x509_hash"
sdjwt_response_mode                = "direct_post.jwt"
sdjwt_request_uri_method           = "get"
sdjwt_custom_url_scheme            = "haip-vp://"
sdjwt_credential_types             = "https://credentials.example.com/identity_credential"
sdjwt_require_nbf_claim            = "false"
sdjwt_require_exp_claim            = "true"
sdjwt_holder_binding_proof_max_age = "60"
sdjwt_enforce_revocation_status    = "true"
sdjwt_require_cryptographic_holder_binding = "true"
sdjwt_verify_issuer_claim          = "true"
sdjwt_fallback_to_iso_spec_session_transcript = "false"
# Paste full values only in local gitignored secrets-dev.tfvars
sdjwt_access_certificate       = "<ACCESS_CERTIFICATE_BASE64_DER>"
sdjwt_registration_certificate = "<REGISTRATION_CERTIFICATE_JWT>"

# Optional: issuer root display metadata (realm attribute: oid4vci.display).
# Must be a JSON array string.
oid4vci_display = "[{\"name\":\"DATEV Unternehmensdaten\",\"locale\":\"de-DE\",\"logo\":{\"uri\":\"https://wallet-app-metadata-main.s3.eu-central-1.amazonaws.com/adorsys-logo-primary.png\",\"alt_text\":\"DATEV\"}}]"

# Optional but recommended: pin dev realm scopes so PoS-only scopes are not applied to dev.
enabled_scope_names = [
  "BankEmployeeCredential",
  "CityRegistryCredential",
  "DatevCompanyCredential",
  "IdentityCredential",
  "KMACredential",
  "SteuerberaterCredential"
]

# Optional: attach OID4VC credential scopes only to selected clients.
# Current oid4vc-vci setup uses both demo public and confidential API clients.
optional_client_scope_client_ids = [
  "oid4vc-demo-public",
  "openid4vc-rest-api"
]

