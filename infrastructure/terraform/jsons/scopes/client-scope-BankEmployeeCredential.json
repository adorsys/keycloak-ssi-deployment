{
  "name": "BankEmployeeCredential",
  "protocol": "oid4vc",
  "attributes": {
    "vc.credential_configuration_id": "BankEmployeeCredential",
    "vc.credential_contexts": "employee_vct",
    "vc.credential_build_config.sd_jwt.visible_claims": "id,iat,nbf,exp,jti",
    "vc.credential_build_config.hash_algorithm": "sha-256",
    "vc.supported_credential_types": "employee_vct",
    "vc.format": "dc+sd-jwt",
    "include.in.openid.provider.metadata": "true",
    "include.in.token.scope": "true",
    "vc.display": "[{\"locale\":\"de-DE\",\"name\":\"Bankmitarbeiter-Ausweis\",\"description\":\"Mitarbeiternachweis für Bankpersonal\",\"logo\":{\"uri\":\"https://wallet-app-metadata.s3.eu-north-1.amazonaws.com/demo_bank_logo.png\",\"alt_text\":\"Bank Employee Credential\"},\"background_color\":\"#f0f0f0\",\"text_color\":\"#000000\"},{\"locale\":\"en-US\",\"name\":\"Bank Employee Credential\",\"description\":\"Employee credential for bank staff\",\"logo\":{\"uri\":\"https://wallet-app-metadata.s3.eu-north-1.amazonaws.com/demo_bank_logo.png\",\"alt_text\":\"Bank Employee Credential\"},\"background_color\":\"#f0f0f0\",\"text_color\":\"#000000\"}]",
    "vc.cryptographic_binding_methods_supported": "jwk",
    "vc.expiry_in_seconds": "31536000",
    "vc.verifiable_credential_type": "employee_vct",
    "vc.include_in_metadata": "true",
    "vc.credential_build_config.token_jws_type": "dc+sd-jwt",
    "vc.credential_signing_alg": "ES256",
    "display.on.consent.screen": "true",
    "vc.sd_jwt.number_of_decoys": "2",
    "vc.credential_identifier": "BankEmployeeCredential"
  },
  "protocolMappers": [
    {
      "name": "address-mapper-kma",
      "protocol": "oid4vc",
      "protocolMapper": "oid4vc-user-attribute-mapper",
      "consentRequired": false,
      "config": {
        "claim.name": "address",
        "vc.display": "[{\"locale\":\"de-DE\",\"name\":\"Adresse\"},{\"locale\":\"en-US\",\"name\":\"Address\"}]",
        "userAttribute": "address"
      }
    },
    {
      "name": "last_name-mapper-kma",
      "protocol": "oid4vc",
      "protocolMapper": "oid4vc-user-attribute-mapper",
      "consentRequired": false,
      "config": {
        "claim.name": "family_name",
        "vc.display": "[{\"locale\":\"de-DE\",\"name\":\"Nachname\"},{\"locale\":\"en-US\",\"name\":\"Lastname\"}]",
        "userAttribute": "lastName"
      }
    },
    {
      "name": "department-mapper-kma",
      "protocol": "oid4vc",
      "protocolMapper": "oid4vc-static-claim-mapper",
      "consentRequired": false,
      "config": {
        "claim.name": "department",
        "vc.display": "[{\"locale\":\"de-DE\",\"name\":\"Abteilung\"},{\"locale\":\"en-US\",\"name\":\"Department\"}]",
        "staticValue": "Customer Service"
      }
    },
    {
      "name": "id-mapper-kma",
      "protocol": "oid4vc",
      "protocolMapper": "oid4vc-subject-id-mapper",
      "consentRequired": false,
      "config": {}
    },
    {
      "name": "nbf-oid4vc-issued-at-time-claim-mapper-kma",
      "protocol": "oid4vc",
      "protocolMapper": "oid4vc-issued-at-time-claim-mapper",
      "consentRequired": false,
      "config": {
        "claim.name": "nbf",
        "valueSource": "COMPUTE"
      }
    },
    {
      "name": "iat-oid4vc-issued-at-time-claim-mapper-kma",
      "protocol": "oid4vc",
      "protocolMapper": "oid4vc-issued-at-time-claim-mapper",
      "consentRequired": false,
      "config": {
        "claim.name": "iat",
        "truncateToTimeUnit": "HOURS",
        "valueSource": "COMPUTE"
      }
    },
    {
      "name": "username-mapper-kma",
      "protocol": "oid4vc",
      "protocolMapper": "oid4vc-user-attribute-mapper",
      "consentRequired": false,
      "config": {
        "claim.name": "username",
        "vc.display": "[{\"locale\":\"de-DE\",\"name\":\"Benutzername\"},{\"locale\":\"en-US\",\"name\":\"Username\"}]",
        "userAttribute": "username"
      }
    },
    {
      "name": "date-of-birth-mapper-kma",
      "protocol": "oid4vc",
      "protocolMapper": "oid4vc-user-attribute-mapper",
      "consentRequired": false,
      "config": {
        "claim.name": "date_of_birth",
        "vc.display": "[{\"locale\":\"de-DE\",\"name\":\"Geburtsdatum\"},{\"locale\":\"en-US\",\"name\":\"Date of Birth\"}]",
        "userAttribute": "date_of_birth"
      }
    },
    {
      "name": "role-mapper-kma",
      "protocol": "oid4vc",
      "protocolMapper": "oid4vc-static-claim-mapper",
      "consentRequired": false,
      "config": {
        "claim.name": "role",
        "vc.display": "[{\"locale\":\"de-DE\",\"name\":\"Rolle\"},{\"locale\":\"en-US\",\"name\":\"Role\"}]",
        "staticValue": "Teller"
      }
    },
    {
      "name": "employer-name-mapper-kma",
      "protocol": "oid4vc",
      "protocolMapper": "oid4vc-static-claim-mapper",
      "consentRequired": false,
      "config": {
        "claim.name": "employer_name",
        "vc.display": "[{\"locale\":\"de-DE\",\"name\":\"Arbeitgeber\"},{\"locale\":\"en-US\",\"name\":\"Employer\"}]",
        "staticValue": "Demo Bank GmbH"
      }
    },
    {
      "name": "employee-id-mapper-kma",
      "protocol": "oid4vc",
      "protocolMapper": "oid4vc-user-attribute-mapper",
      "consentRequired": false,
      "config": {
        "claim.name": "employee_id",
        "vc.display": "[{\"locale\":\"de-DE\",\"name\":\"Mitarbeiter-ID\"},{\"locale\":\"en-US\",\"name\":\"Employee ID\"}]",
        "userAttribute": "employee_id"
      }
    },
    {
      "name": "given_name-mapper-kma",
      "protocol": "oid4vc",
      "protocolMapper": "oid4vc-user-attribute-mapper",
      "consentRequired": false,
      "config": {
        "claim.name": "given_name",
        "vc.display": "[{\"locale\":\"de-DE\",\"name\":\"Vorname\"},{\"locale\":\"en-US\",\"name\":\"Name\"}]",
        "userAttribute": "firstName"
      }
    },
    {
      "name": "email-mapper-kma",
      "protocol": "oid4vc",
      "protocolMapper": "oid4vc-user-attribute-mapper",
      "consentRequired": false,
      "config": {
        "claim.name": "email",
        "vc.display": "[{\"locale\":\"de-DE\",\"name\":\"E-Mail\"},{\"locale\":\"en-US\",\"name\":\"Email\"}]",
        "userAttribute": "email"
      }
    }
  ]
}
