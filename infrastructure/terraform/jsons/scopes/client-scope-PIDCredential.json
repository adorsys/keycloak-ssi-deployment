{
  "name": "PIDCredential",
  "protocol": "oid4vc",
  "attributes": {
    "vc.credential_configuration_id": "PIDCredential",
    "vc.credential_identifier": "PIDCredential",
    "vc.format": "mso_mdoc",
    "vc.credential_signing_alg": "ES256",
    "vc.verifiable_credential_type": "eu.europa.ec.eudi.pid.1",
    "vc.expiry_in_seconds": "31536000",
    "vc.binding_required": "true",
    "vc.binding_required_proof_types": "jwt",
    "vc.cryptographic_binding_methods_supported": "cose_key",
    "include.in.token.scope": "true",
    "vc.include_in_metadata": "true",
    "vc.display": "[{\"locale\":\"en-US\",\"name\":\"Local PID mDoc\",\"description\":\"Local end-to-end PID mDoc test credential\"}]"
  },
  "protocolMappers": [
    {
      "name": "personal-administrative-number-mapper",
      "protocol": "oid4vc",
      "protocolMapper": "oid4vc-subject-id-mapper",
      "consentRequired": false,
      "config": {
        "claim.name": "personal_administrative_number",
        "userAttribute": "id",
        "mdoc.namespace": "eu.europa.ec.eudi.pid.1"
      }
    },
    {
      "name": "given-name-mapper",
      "protocol": "oid4vc",
      "protocolMapper": "oid4vc-user-attribute-mapper",
      "consentRequired": false,
      "config": {
        "claim.name": "given_name",
        "userAttribute": "firstName",
        "mdoc.namespace": "eu.europa.ec.eudi.pid.1"
      }
    },
    {
      "name": "family-name-mapper",
      "protocol": "oid4vc",
      "protocolMapper": "oid4vc-user-attribute-mapper",
      "consentRequired": false,
      "config": {
        "claim.name": "family_name",
        "userAttribute": "lastName",
        "mdoc.namespace": "eu.europa.ec.eudi.pid.1"
      }
    },
    {
      "name": "issuing-authority-mapper",
      "protocol": "oid4vc",
      "protocolMapper": "oid4vc-static-claim-mapper",
      "consentRequired": false,
      "config": {
        "claim.name": "issuing_authority",
        "staticValue": "Local Keycloak PID Provider",
        "mdoc.namespace": "eu.europa.ec.eudi.pid.1"
      }
    }
  ]
}
