{
  "name": "PayslipCredential",
  "description": "Digitally verifiable payslip credential for income proof and loan applications",
  "protocol": "oid4vc",
  "attributes": {
    "vc.credential_configuration_id": "PayslipCredential",
    "vc.credential_contexts": "payslip_vct",
    "vc.credential_build_config.sd_jwt.visible_claims": "id,iat,nbf,exp,jti",
    "vc.credential_build_config.hash_algorithm": "sha-256",
    "vc.supported_credential_types": "payslip_vct",
    "vc.format": "dc+sd-jwt",
    "include.in.openid.provider.metadata": "true",
    "include.in.token.scope": "true",
    "vc.display": "[{\"locale\":\"de-DE\",\"name\":\"Gehaltsnachweis\",\"description\":\"Digital verifizierbarer Gehaltsnachweis f\u00fcr Einkommensnachweise und Kreditantr\u00e4ge\",\"background_image\":{\"uri\":\"https://wallet-app-metadata-main.s3.eu-central-1.amazonaws.com/payslip-credential-background-img.webp\"},\"background_color\":\"#b5441d\",\"text_color\":\"#ffffff\"},{\"locale\":\"en-US\",\"name\":\"Payslip Credential\",\"description\":\"Digitally verifiable payslip for income proof and loan applications\",\"background_image\":{\"uri\":\"https://wallet-app-metadata-main.s3.eu-central-1.amazonaws.com/payslip-credential-background-img.webp\"},\"background_color\":\"#b5441d\",\"text_color\":\"#ffffff\"}]",
    "vc.cryptographic_binding_methods_supported": "jwk",
    "vc.expiry_in_seconds": "31536000",
    "vc.verifiable_credential_type": "payslip_vct",
    "vc.include_in_metadata": "true",
    "vc.credential_build_config.token_jws_type": "dc+sd-jwt",
    "vc.credential_signing_alg": "ES256",
    "display.on.consent.screen": "true",
    "vc.sd_jwt.number_of_decoys": "2",
    "vc.credential_identifier": "PayslipCredential",
    "vc.binding_required": "true",
    "vc.binding_required_proof_types": "jwt"
  },
  "protocolMappers": [
    {
      "name": "id-mapper-payslip",
      "protocol": "oid4vc",
      "protocolMapper": "oid4vc-static-claim-mapper",
      "consentRequired": false,
      "config": {
        "claim.name": "sub",
        "staticValue": "payslip-subject-001",
        "vc.display": "[{\"locale\":\"de-DE\",\"name\":\"Subjekt-ID\"}]",
        "vc.include_in_metadata": "false"
      }
    },
    {
      "name": "username-mapper-payslip",
      "protocol": "oid4vc",
      "protocolMapper": "oid4vc-user-attribute-mapper",
      "consentRequired": false,
      "config": {
        "claim.name": "username",
        "userAttribute": "username",
        "vc.display": "[{\"locale\":\"de-DE\",\"name\":\"Benutzername\"}]",
        "vc.include_in_metadata": "false"
      }
    },
    {
      "name": "iat-oid4vc-issued-at-time-claim-mapper-payslip",
      "protocol": "oid4vc",
      "protocolMapper": "oid4vc-issued-at-time-claim-mapper",
      "consentRequired": false,
      "config": {
        "claim.name": "iat",
        "truncateToTimeUnit": "HOURS",
        "valueSource": "COMPUTE"
      }
    },
    {
      "name": "nbf-oid4vc-issued-at-time-claim-mapper-payslip",
      "protocol": "oid4vc",
      "protocolMapper": "oid4vc-issued-at-time-claim-mapper",
      "consentRequired": false,
      "config": {
        "claim.name": "nbf",
        "valueSource": "COMPUTE"
      }
    },
    {
      "name": "payslip-employee-name",
      "protocol": "oid4vc",
      "protocolMapper": "oid4vc-static-claim-mapper",
      "consentRequired": false,
      "config": {
        "claim.name": "employee_name",
        "staticValue": "Max Mustermann",
        "vc.mandatory": "true",
        "vc.display": "[{\"locale\":\"de-DE\",\"name\":\"Arbeitnehmer\"},{\"locale\":\"en-US\",\"name\":\"Employee\"}]"
      }
    },
    {
      "name": "payslip-first-name",
      "protocol": "oid4vc",
      "protocolMapper": "oid4vc-user-attribute-mapper",
      "consentRequired": false,
      "config": {
        "claim.name": "first_name",
        "userAttribute": "firstName",
        "vc.mandatory": "true",
        "vc.display": "[{\"locale\":\"de-DE\",\"name\":\"Vorname\"},{\"locale\":\"en-US\",\"name\":\"First Name\"}]"
      }
    },
    {
      "name": "payslip-last-name",
      "protocol": "oid4vc",
      "protocolMapper": "oid4vc-user-attribute-mapper",
      "consentRequired": false,
      "config": {
        "claim.name": "last_name",
        "userAttribute": "lastName",
        "vc.mandatory": "true",
        "vc.display": "[{\"locale\":\"de-DE\",\"name\":\"Nachname\"},{\"locale\":\"en-US\",\"name\":\"Last Name\"}]"
      }
    },
    {
      "name": "payslip-employer-name",
      "protocol": "oid4vc",
      "protocolMapper": "oid4vc-static-claim-mapper",
      "consentRequired": false,
      "config": {
        "claim.name": "employer_name",
        "staticValue": "Beispiel GmbH",
        "vc.mandatory": "true",
        "vc.display": "[{\"locale\":\"de-DE\",\"name\":\"Arbeitgeber\"},{\"locale\":\"en-US\",\"name\":\"Employer\"}]"
      }
    },
    {
      "name": "payslip-payroll-period",
      "protocol": "oid4vc",
      "protocolMapper": "oid4vc-static-claim-mapper",
      "consentRequired": false,
      "config": {
        "claim.name": "payroll_period",
        "staticValue": "April 2026",
        "vc.mandatory": "true",
        "vc.display": "[{\"locale\":\"de-DE\",\"name\":\"Abrechnungszeitraum\"},{\"locale\":\"en-US\",\"name\":\"Payroll Period\"}]"
      }
    },
    {
      "name": "payslip-issue-date",
      "protocol": "oid4vc",
      "protocolMapper": "oid4vc-static-claim-mapper",
      "consentRequired": false,
      "config": {
        "claim.name": "issue_date",
        "staticValue": "2026-04-30",
        "vc.mandatory": "true",
        "vc.display": "[{\"locale\":\"de-DE\",\"name\":\"Ausstellungsdatum\"},{\"locale\":\"en-US\",\"name\":\"Issue Date\"}]"
      }
    },
    {
      "name": "payslip-document-id",
      "protocol": "oid4vc",
      "protocolMapper": "oid4vc-static-claim-mapper",
      "consentRequired": false,
      "config": {
        "claim.name": "document_id",
        "staticValue": "PAY-2026-04-12345",
        "vc.mandatory": "true",
        "vc.display": "[{\"locale\":\"de-DE\",\"name\":\"Dokument-ID\"},{\"locale\":\"en-US\",\"name\":\"Document ID\"}]"
      }
    },
    {
      "name": "payslip-gross-salary",
      "protocol": "oid4vc",
      "protocolMapper": "oid4vc-static-claim-mapper",
      "consentRequired": false,
      "config": {
        "claim.name": "gross_salary",
        "staticValue": "5000.00",
        "vc.mandatory": "true",
        "vc.display": "[{\"locale\":\"de-DE\",\"name\":\"Bruttogehalt\"},{\"locale\":\"en-US\",\"name\":\"Gross Salary\"}]"
      }
    },
    {
      "name": "payslip-net-salary",
      "protocol": "oid4vc",
      "protocolMapper": "oid4vc-static-claim-mapper",
      "consentRequired": false,
      "config": {
        "claim.name": "net_salary",
        "staticValue": "3200.00",
        "vc.mandatory": "true",
        "vc.display": "[{\"locale\":\"de-DE\",\"name\":\"Nettogehalt\"},{\"locale\":\"en-US\",\"name\":\"Net Salary\"}]"
      }
    },
    {
      "name": "payslip-currency",
      "protocol": "oid4vc",
      "protocolMapper": "oid4vc-static-claim-mapper",
      "consentRequired": false,
      "config": {
        "claim.name": "currency",
        "staticValue": "EUR",
        "vc.mandatory": "true",
        "vc.display": "[{\"locale\":\"de-DE\",\"name\":\"W\u00e4hrung\"},{\"locale\":\"en-US\",\"name\":\"Currency\"}]"
      }
    },
    {
      "name": "payslip-payment-date",
      "protocol": "oid4vc",
      "protocolMapper": "oid4vc-static-claim-mapper",
      "consentRequired": false,
      "config": {
        "claim.name": "payment_date",
        "staticValue": "2026-04-30",
        "vc.mandatory": "true",
        "vc.display": "[{\"locale\":\"de-DE\",\"name\":\"Auszahlungsdatum\"},{\"locale\":\"en-US\",\"name\":\"Payment Date\"}]"
      }
    }
  ]
}