{
  "name": "CityRegistryCredential",
  "protocol": "oid4vc",
  "attributes": {
    "vc.credential_configuration_id": "CityRegistryCredential",
    "vc.credential_contexts": "city_vct",
    "vc.credential_build_config.sd_jwt.visible_claims": "id,iat,nbf,exp,jti",
    "vc.credential_build_config.hash_algorithm": "sha-256",
    "vc.supported_credential_types": "city_vct",
    "vc.format": "dc+sd-jwt",
    "include.in.openid.provider.metadata": "true",
    "include.in.token.scope": "true",
    "vc.display": "[{\"locale\":\"de-DE\",\"name\":\"City Registry Credential\",\"description\":\"Nachweis aus dem Stadtregister\",\"logo\":{\"uri\":\"https://wallet-app-metadata-main.s3.eu-central-1.amazonaws.com/demo_city_logo.png\",\"alt_text\":\"City Registry\"},\"background_color\":\"#FFFFD4\",\"text_color\":\"#000000\"},{\"locale\":\"en-US\",\"name\":\"City Registry Credential\",\"description\":\"Credential issued by city registry\",\"logo\":{\"uri\":\"https://wallet-app-metadata-main.s3.eu-central-1.amazonaws.com/demo_city_logo.png\",\"alt_text\":\"City Registry\"},\"background_color\":\"#FFFFD4\",\"text_color\":\"#000000\"}]",
    "vc.cryptographic_binding_methods_supported": "jwk",
    "vc.expiry_in_seconds": "31536000",
    "vc.verifiable_credential_type": "city_vct",
    "vc.include_in_metadata": "true",
    "vc.credential_build_config.token_jws_type": "dc+sd-jwt",
    "vc.credential_signing_alg": "ES256",
    "display.on.consent.screen": "true",
    "vc.sd_jwt.number_of_decoys": "2",
    "vc.credential_identifier": "CityRegistryCredential",
    "vc.binding_required": "true",
    "vc.binding_required_proof_types": "jwt"
  },
  "protocolMappers": [
    {
      "name": "nbf-oid4vc-issued-at-time-claim-mapper-kma",
      "protocol": "oid4vc",
      "protocolMapper": "oid4vc-issued-at-time-claim-mapper",
      "consentRequired": false,
      "config": {
        "claim.name": "nbf",
        "valueSource": "COMPUTE"
      }
    },
    {
      "name": "lastname-mapper-kma",
      "protocol": "oid4vc",
      "protocolMapper": "oid4vc-user-attribute-mapper",
      "consentRequired": false,
      "config": {
        "claim.name": "family_name",
        "vc.display": "[{\"locale\":\"de-DE\",\"name\":\"Nachname\"},{\"locale\":\"en-US\",\"name\":\"Lastname\"}]",
        "userAttribute": "lastName"
      }
    },
    {
      "name": "postcode-mapper-kma",
      "protocol": "oid4vc",
      "protocolMapper": "oid4vc-static-claim-mapper",
      "consentRequired": false,
      "config": {
        "claim.name": "postcode",
        "vc.display": "[{\"locale\":\"de-DE\",\"name\":\"Postleitzahl\"},{\"locale\":\"en-US\",\"name\":\"Postcode\"}]",
        "staticValue": "10115"
      }
    },
    {
      "name": "iat-oid4vc-issued-at-time-claim-mapper-kma",
      "protocol": "oid4vc",
      "protocolMapper": "oid4vc-issued-at-time-claim-mapper",
      "consentRequired": false,
      "config": {
        "claim.name": "iat",
        "truncateToTimeUnit": "HOURS",
        "valueSource": "COMPUTE"
      }
    },
    {
      "name": "id-mapper-city-registry",
      "protocol": "oid4vc",
      "protocolMapper": "oid4vc-static-claim-mapper",
      "consentRequired": false,
      "config": {
        "claim.name": "sub",
        "staticValue": "city-registry-subject-001",
        "vc.display": "[{\"locale\":\"de-DE\",\"name\":\"Subjekt-ID\"}]",
        "vc.include_in_metadata": "false"
      }
    },
    {
      "name": "username-mapper-kma",
      "protocol": "oid4vc",
      "protocolMapper": "oid4vc-user-attribute-mapper",
      "consentRequired": false,
      "config": {
        "claim.name": "username",
        "vc.display": "[{\"locale\":\"de-DE\",\"name\":\"Benutzername\"},{\"locale\":\"en-US\",\"name\":\"Username\"}]",
        "userAttribute": "username"
      }
    },
    {
      "name": "id-number-mapper-kma",
      "protocol": "oid4vc",
      "protocolMapper": "oid4vc-static-claim-mapper",
      "consentRequired": false,
      "config": {
        "claim.name": "id_number",
        "vc.display": "[{\"locale\":\"de-DE\",\"name\":\"ID-Nummer\"},{\"locale\":\"en-US\",\"name\":\"ID Number\"}]",
        "staticValue": "CR-2026-458972"
      }
    },
    {
      "name": "given_name-mapper-kma",
      "protocol": "oid4vc",
      "protocolMapper": "oid4vc-user-attribute-mapper",
      "consentRequired": false,
      "config": {
        "claim.name": "given_name",
        "vc.display": "[{\"locale\":\"de-DE\",\"name\":\"Vorname\"},{\"locale\":\"en-US\",\"name\":\"Name\"}]",
        "userAttribute": "firstName"
      }
    },
    {
      "name": "address-mapper-kma",
      "protocol": "oid4vc",
      "protocolMapper": "oid4vc-static-claim-mapper",
      "consentRequired": false,
      "config": {
        "claim.name": "address",
        "vc.display": "[{\"locale\":\"de-DE\",\"name\":\"Adresse\"},{\"locale\":\"en-US\",\"name\":\"Address\"}]",
        "staticValue": "Musterstraße 123, 10115 Berlin, Germany"
      }
    },
    {
      "name": "date-of-registration-mapper-kma",
      "protocol": "oid4vc",
      "protocolMapper": "oid4vc-user-attribute-mapper",
      "consentRequired": false,
      "config": {
        "claim.name": "date_of_registration",
        "vc.display": "[{\"locale\":\"de-DE\",\"name\":\"Registrierungsdatum\"},{\"locale\":\"en-US\",\"name\":\"Date of Registration\"}]",
        "userAttribute": "date_of_registration"
      }
    }
  ]
}
