# Copy to `secrets-oid4vci-demo-env.tfvars` (gitignored) and fill in real values.
# This file configures realm `oid4vci-demo-env` on the standalone Compose Keycloak.
# Never commit the copied tfvars file; Terraform state also contains sensitive data.

keycloak_url = "https://keycloak-demo-env.solutions.adorsys.com"
realm        = "oid4vci-demo-env"

admin_password                   = "<KEYCLOAK_ADMIN_PASSWORD>"
initial_password                 = "<FRANCIS_INITIAL_PASSWORD>"
max_mustermann_initial_password  = "<MAX_MUSTERMANN_INITIAL_PASSWORD>"
pdi_test_user_initial_password   = "<ERIKA_MUSTERMANN_INITIAL_PASSWORD>"
openid4vc_rest_api_client_secret = "<OPENID4VC_REST_API_CLIENT_SECRET>"

# This is the path as seen inside the Keycloak container. Compose mounts the
# host's KEYCLOAK_KEYSTORE_HOST_ROOT at /opt/keycloak/data/keystores.
oid4vc_keystore_path     = "/opt/keycloak/data/keystores/oid4vci-demo-env/oid4vc-ecdsa-only.new.p12"
oid4vc_keystore_password = "<OID4VC_KEYSTORE_PASSWORD>"
oid4vc_keystore_type     = "PKCS12"
oid4vc_ecdsa_key_alias   = "ecdsa_team_key"
enable_rsa_keys          = false
enabled_scope_names = [
  "IdentityCredential",
]
optional_client_scope_client_ids = [
  "oid4vc-demo-public",
  "openid4vc-rest-api",
  "cbc61b45-907a-4c65-8467-3194d8af12ab"
]

# Gate IdentityCredential issuance on a same-device German PID presentation.
oid4vci_presentation_during_issuance = true
pdi_credential_scope_name            = "IdentityCredential"
pdi_authentication_profile_id        = "identity-pid-presentation"
pdi_test_user_enabled                = true
pdi_wallet_client_enabled            = true

# Root issuer display metadata; keep this as a JSON array string.
oid4vci_display             = "[{\"name\": \"Adorsys Identitätsnachweis Demo\", \"locale\": \"de-DE\"}, {\"name\": \"Adorsys Identity Credential Demo\", \"locale\": \"en-US\"}]"
oid4vci_signed_metadata_alg = "ES256"

# German-wallet OID4VCI settings for OID4VP plugin 1.4.5.
oid4vci_allow_proof_iss_mismatch             = false
oid4vci_omit_encryption_metadata             = false
oid4vci_patch_credential_requests            = true
oid4vci_patch_metadata_x5c_to_leaf_cert_only = true

# Token Status List issuer settings for this demo realm.
# Keep the prefix stable after first registration because it forms the issuer ID.
# For the first apply, override status_list_enabled=false until the final ES256 key is active.
status_list_enabled             = true
status_list_server_url          = "https://statuslist.eudi-adorsys.com"
status_list_mandatory           = true
status_list_token_issuer_prefix = "adorsys-keycloak-demo-env"

# PDI uses the German PID as session identity and matches given_name/family_name
# to Erika's account. The trust-list signer verifies the list JWT; the PID
# issuance CA is read from the signed list. Download the current signer from
# https://trustlists-sandbox.eudihub.de/certificate.pem and convert to base64 DER.
# Expected SHA-256: 56:A7:0F:F7:0C:C4:7B:4E:91:21:6B:8D:A7:B9:3F:FA:CA:D3:48:83:CD:ED:5D:88:1D:EA:8E:73:D1:98:2F:56.
oid4vp_authentication_profiles                 = <<-EOT
[
  {
    "id": "identity-pid-presentation",
    "description": "Present German PID to bind IdentityCredential issuance to the logged-in test user.",
    "displayCta": {
      "en": "Present German PID to issue Identity Credential"
    },
    "credentials": [
      {
        "id": "pid",
        "role": "primary",
        "identitySource": "session",
        "format": "mso_mdoc",
        "credentialTypes": [
          "eu.europa.ec.eudi.pid.1"
        ],
        "claims": [
          "eu.europa.ec.eudi.pid.1/given_name",
          "eu.europa.ec.eudi.pid.1/family_name"
        ],
        "trust": [
          {
            "type": "eudi_pid_trust_list",
            "issuer": "VATDE-202620438",
            "trustListUrl": "https://trustlists-sandbox.eudihub.de/pid-provider.jwt",
            "trustListSigningCertificate": "<PID_TRUST_LIST_SIGNING_CERTIFICATE_BASE64_DER>",
            "serviceType": "http://uri.etsi.org/19602/SvcType/PID/Issuance"
          }
        ],
        "binding": [
          {
            "type": "claim_equals_user_attribute",
            "credentialClaim": "eu.europa.ec.eudi.pid.1/given_name",
            "userAttribute": "firstName",
            "caseInsensitive": true
          },
          {
            "type": "claim_equals_user_attribute",
            "credentialClaim": "eu.europa.ec.eudi.pid.1/family_name",
            "userAttribute": "lastName",
            "caseInsensitive": true
          }
        ]
      }
    ]
  }
]
EOT
oid4vp_client_identifier_prefix                = "x509_hash"
oid4vp_response_mode                           = "direct_post.jwt"
oid4vp_request_uri_method                      = "get"
oid4vp_custom_url_scheme                       = "openid4vp://"
oid4vp_transaction_data                        = ""
oid4vp_verifier_info                           = ""
oid4vp_require_cryptographic_holder_binding    = "true"
oid4vp_holder_binding_proof_max_age            = "60"
oid4vp_require_nbf_claim                       = "false"
oid4vp_require_exp_claim                       = "false"
oid4vp_verify_issuer_claim                     = "true"
oid4vp_fallback_to_iso_spec_session_transcript = "false"
oid4vp_enforce_revocation_status               = "true"
oid4vp_allow_missing_status_claim              = "false"
# Empty uses Keycloak's global truststore for the Status List JWT x5c chain.
oid4vp_status_list_trust_material_idps = ""
oid4vp_access_certificate              = "<ACCESS_CERTIFICATE_BASE64_DER>"
oid4vp_registration_certificate        = "<REGISTRATION_CERTIFICATE_JWT>"

# The mock frontend is served at the domain root behind the ALB/Caddy.
oid4vc_demo_public_valid_redirect_uris = [
  "https://issuer-mock-fe.solutions.adorsys.com/*"
]
oid4vc_demo_public_web_origins = [
  "https://issuer-mock-fe.solutions.adorsys.com"
]
oid4vc_demo_public_post_logout_redirect_uris = "https://issuer-mock-fe.solutions.adorsys.com##https://issuer-mock-fe.solutions.adorsys.com/*"
