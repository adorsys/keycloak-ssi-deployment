# Copy this file to the repository root as .env.demo, then replace placeholders.

KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.8.2
KEYCLOAK_PUBLIC_URL=https://keycloak-demo-env.solutions.adorsys.com
KEYCLOAK_HOST=keycloak-demo-env.solutions.adorsys.com
MOCK_FE_HOST=issuer-mock-fe.solutions.adorsys.com
CADDY_HOST_PORT=8081

KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-strong-demo-password
KEYCLOAK_LOG_LEVEL=info
KEYCLOAK_FEATURES=oid4vc-vci,oid4vc-vci-preauth-code,oid4vc-vci-rest-credential-offer
DATABASE_MIGRATION_STRATEGY=update
OID4VP_AUTH_MANAGED_REALMS=oid4vci-demo-env
OID4VP_AUTH_VERBOSE_ERRORS=false

POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=replace-with-a-strong-demo-password

# Absolute host path containing realm-named directories with the keystores.
KEYCLOAK_KEYSTORE_HOST_ROOT=/path/to/realm-keystores

# Existing SSI wrapper output directory; must contain keycloak-server.crt.pem
# and keycloak-server.key.pem generated by the wrapper.
KEYCLOAK_TLS_HOST_DIR=/path/to/keycloak-server-certs

# Use the image you provide. It must listen on MOCK_FE_PORT and accept these
# VITE_* runtime variables.
MOCK_FE_IMAGE=ghcr.io/adorsys-gis/keycloak-oid4vc-mock-fe:0.1.0
MOCK_FE_PORT=8080
MOCK_FE_REALM=oid4vci-demo-env
MOCK_FE_CLIENT_ID=oid4vc-demo-public
MOCK_FE_CREDENTIAL_CONFIGURATION_ID=IdentityCredential
MOCK_FE_PRE_AUTHORIZED=false

CADDY_IMAGE=caddy:2-alpine
