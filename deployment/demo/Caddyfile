http://{$KEYCLOAK_HOST} {
	reverse_proxy https://keycloak:8443 {
		transport http {
			tls_trust_pool file /etc/caddy/keycloak-tls/keycloak-server.crt.pem
			tls_server_name app
		}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Port 443
		header_up X-Forwarded-Host {host}
	}
}

http://{$MOCK_FE_HOST} {
	reverse_proxy mock-fe:{$MOCK_FE_PORT} {
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Port 443
		header_up X-Forwarded-Host {host}
	}
}
